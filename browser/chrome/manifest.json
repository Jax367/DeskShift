{
  "manifest_version": 3,
  "name": "DeskShift · 壁纸新标签页",
  "version": "1.0.2",
  "description": "新标签页自动跟随 DeskShift 配色，使用纯色背景。仅连接本机，不读取浏览记录。",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:47831/*"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:47831; img-src 'self';" }
}
